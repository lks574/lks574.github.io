---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_SUBTITLE, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 4);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${SITE_TITLE} | ${SITE_SUBTITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-badge">Product Engineer & AI Era</div>
				<h1 class="hero-title">{SITE_TITLE}</h1>
				<p class="hero-subtitle">{SITE_SUBTITLE}</p>
				<p class="hero-description">
					단순히 기능 요구사항을 코드로 옮기는 개발자를 넘어,
					비즈니스 임팩트를 직접 만들고 AI 에이전트와 협업하며 속도와 완성도를 극한으로 끌어올리는
					<strong>Product Engineer(PE)</strong>로의 여정과 생존 전략을 기록합니다.
				</p>
				<div class="hero-actions">
					<a href="/blog" class="btn btn-primary">전체 아티클 읽기 →</a>
					<a href="/about" class="btn btn-secondary">저자 소개</a>
				</div>
			</section>

			<!-- Categories Section -->
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">주요 탐색 주제</h2>
					<p class="section-desc">블로그에서 다루는 4가지 핵심 축입니다.</p>
				</div>
				<div class="category-grid">
					{
						Object.values(CATEGORIES).map((cat) => (
							<a href={`/category/${cat.slug}`} class="category-card">
								<div class="category-icon">{cat.icon}</div>
								<h3 class="category-name">{cat.name}</h3>
								<p class="category-summary">{cat.description}</p>
							</a>
						))
					}
				</div>
			</section>

			<!-- Recent Posts Section -->
			<section class="section">
				<div class="section-header">
					<div class="section-title-wrap">
						<h2 class="section-title">최신 아티클</h2>
						<a href="/blog" class="view-all">전체보기 &rarr;</a>
					</div>
				</div>
				<div class="post-list">
					{
						recentPosts.map((post) => {
							const catInfo = CATEGORIES[post.data.category] || {
								name: post.data.category,
								slug: post.data.category,
							};
							return (
								<article class="post-card">
									<a href={`/blog/${post.id}/`} class="post-card-link">
										<div class="post-meta">
											<span class={`badge badge-${post.data.category}`}>
												{catInfo.name}
											</span>
											<span class="post-date">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</div>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-description">{post.data.description}</p>
										{post.data.tags && post.data.tags.length > 0 && (
											<div class="post-tags">
												{post.data.tags.map((tag: string) => (
													<span class="tag">#{tag}</span>
												))}
											</div>
										)}
									</a>
								</article>
							);
						})
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 3rem 0 3.5rem 0;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 3.5rem;
	}

	.hero-badge {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		background-color: var(--accent-subtle);
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		margin-bottom: 1.25rem;
		border: 1px solid var(--accent-border);
	}

	.hero-title {
		font-size: 3rem;
		font-weight: 800;
		margin: 0 0 0.75rem 0;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.hero-subtitle {
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 1.25rem;
		letter-spacing: -0.015em;
	}

	.hero-description {
		font-size: 1.1rem;
		color: var(--text-secondary);
		line-height: 1.8;
		max-width: 680px;
		margin-bottom: 2rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.75rem 1.4rem;
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.95rem;
		transition: all 0.15s ease;
		text-decoration: none;
	}

	.btn-primary {
		background-color: var(--accent);
		color: white;
	}

	.btn-primary:hover {
		background-color: var(--accent-hover);
		color: white;
	}

	.btn-secondary {
		background-color: var(--bg-secondary);
		color: var(--text-primary);
		border: 1px solid var(--border-color);
	}

	.btn-secondary:hover {
		background-color: var(--border-color);
	}

	.section {
		margin-bottom: 4rem;
	}

	.section-header {
		margin-bottom: 1.75rem;
	}

	.section-title-wrap {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 0.5rem;
	}

	.section-title {
		font-size: 1.5rem;
		margin: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	.section-desc {
		color: var(--text-muted);
		margin: 0.35rem 0 0 0;
		font-size: 0.95rem;
	}

	.view-all {
		font-size: 0.9rem;
		font-weight: 600;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.category-card {
		display: block;
		padding: 1.5rem;
		background-color: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		text-decoration: none;
	}

	.category-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow-hover);
		border-color: var(--accent);
	}

	.category-icon {
		font-size: 1.75rem;
		margin-bottom: 0.75rem;
	}

	.category-name {
		font-size: 1.15rem;
		margin: 0 0 0.5rem 0;
		color: var(--text-primary);
	}

	.category-summary {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin: 0;
		line-height: 1.55;
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.post-card {
		background-color: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.post-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
		border-color: var(--accent);
	}

	.post-card-link {
		display: block;
		padding: 1.5rem;
		text-decoration: none;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.post-date {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.post-title {
		font-size: 1.35rem;
		margin: 0 0 0.6rem 0;
		color: var(--text-primary);
		line-height: 1.4;
	}

	.post-card:hover .post-title {
		color: var(--accent);
	}

	.post-description {
		font-size: 0.95rem;
		color: var(--text-secondary);
		margin: 0 0 1rem 0;
		line-height: 1.6;
	}

	.post-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.hero-title {
			font-size: 2.25rem;
		}
		.category-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

