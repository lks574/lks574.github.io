---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const categoryKeys = Object.keys(CATEGORIES);

	return categoryKeys.map((catKey) => {
		const filteredPosts = posts
			.filter((p) => p.data.category === catKey)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

		return {
			params: { category: catKey },
			props: { category: catKey, posts: filteredPosts },
		};
	});
}

const { category, posts } = Astro.props;
const currentCat = CATEGORIES[category] || {
	name: category,
	description: '',
	icon: '📁',
	slug: category,
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${currentCat.name} | ${SITE_TITLE}`}
			description={`${currentCat.description} - ${SITE_DESCRIPTION}`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="category-header">
				<div class="breadcrumb">
					<a href="/blog">아티클 목록</a> &rarr; <span>{currentCat.name}</span>
				</div>
				<div class="cat-title-row">
					<span class="cat-icon">{currentCat.icon}</span>
					<h1 class="cat-title">{currentCat.name}</h1>
				</div>
				<p class="cat-desc">{currentCat.description}</p>
			</div>

			<!-- Filter Navigation -->
			<div class="category-filter">
				<a href="/blog" class="filter-pill">전체</a>
				{
					Object.values(CATEGORIES).map((cat) => (
						<a
							href={`/category/${cat.slug}`}
							class={`filter-pill ${cat.slug === category ? 'active' : ''}`}
						>
							{cat.icon} {cat.name}
						</a>
					))
				}
			</div>

			<!-- Posts List -->
			<div class="post-grid">
				{
					posts.length === 0 ? (
						<div class="empty-state">
							<p>아직 등록된 글이 없습니다. 곧 유익한 글이 업로드될 예정입니다!</p>
						</div>
					) : (
						posts.map((post) => (
							<article class="post-card">
								<a href={`/blog/${post.id}/`} class="post-card-inner">
									<div class="post-meta">
										<span class={`badge badge-${post.data.category}`}>{currentCat.name}</span>
										<span class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-desc">{post.data.description}</p>
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="post-tags">
											{post.data.tags.map((tag: string) => (
												<span class="tag">#{tag}</span>
											))}
										</div>
									)}
								</a>
							</article>
						))
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.category-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border-color);
	}

	.breadcrumb {
		font-size: 0.88rem;
		color: var(--text-muted);
		margin-bottom: 0.75rem;
	}

	.breadcrumb a {
		color: var(--text-secondary);
	}

	.cat-title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.cat-icon {
		font-size: 2rem;
	}

	.cat-title {
		font-size: 2.25rem;
		margin: 0;
	}

	.cat-desc {
		color: var(--text-secondary);
		margin: 0.5rem 0 0 0;
		font-size: 1.05rem;
	}

	.category-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
	}

	.filter-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.9rem;
		border-radius: 9999px;
		font-size: 0.88rem;
		font-weight: 500;
		background-color: var(--bg-secondary);
		color: var(--text-secondary);
		border: 1px solid var(--border-color);
		transition: all 0.15s ease;
		text-decoration: none;
	}

	.filter-pill:hover {
		background-color: var(--border-color);
		color: var(--text-primary);
	}

	.filter-pill.active {
		background-color: var(--accent);
		color: white;
		border-color: var(--accent);
	}

	.post-grid {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.post-card {
		background-color: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.post-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
		border-color: var(--accent);
	}

	.post-card-inner {
		display: block;
		padding: 1.75rem;
		text-decoration: none;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.post-date {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.post-title {
		font-size: 1.4rem;
		margin: 0 0 0.65rem 0;
		color: var(--text-primary);
		border-bottom: none;
		padding-bottom: 0;
		line-height: 1.35;
	}

	.post-card:hover .post-title {
		color: var(--accent);
	}

	.post-desc {
		font-size: 0.98rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0 0 1rem 0;
	}

	.post-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.empty-state {
		text-align: center;
		padding: 3rem 1rem;
		background-color: var(--bg-secondary);
		border-radius: 12px;
		border: 1px dashed var(--border-color);
	}
</style>
