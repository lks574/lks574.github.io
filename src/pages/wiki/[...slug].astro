---
import { render } from 'astro:content';
import WikiNote from '../../layouts/WikiNote.astro';
import { getBacklinks, getNoteIndex, noteKey, type AnyEntry, type GlossaryEntry } from '../../lib/wiki-links';

type Props = AnyEntry;

export async function getStaticPaths() {
	// Every name that a wikilink can resolve to becomes a page. The index is the
	// single source of the resolution rule, shared with backlink computation.
	const index = await getNoteIndex();
	const seen = new Map<string, string>(); // slug -> key (collision guard)
	const paths: { params: { slug: string }; props: Props }[] = [];
	for (const [name, ref] of index.byName) {
		const prev = seen.get(name);
		if (prev && prev !== ref.key) {
			// Silently dropping a note is how knowledge gets lost at scale.
			// scripts/lint-glossary.mjs reports the same condition as an error.
			throw new Error(`[wiki routes] slug collision on "/wiki/${name}": ${prev} vs ${ref.key}. Rename one file.`);
		}
		seen.set(name, ref.key);
		const found = index.entries.find((e) => noteKey(e.kind, e.entry.id) === ref.key)!;
		paths.push({ params: { slug: name }, props: found });
	}
	return paths;
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);

const glossaryData = kind === 'glossary' ? (entry as GlossaryEntry).data : undefined;
// Bare-slug aliases (/wiki/rag) point search engines at the canonical path.
const canonicalPath = kind === 'glossary' ? `/wiki/glossary/${entry.id}/` : `/wiki/${entry.id}/`;
const backlinks = (await getBacklinks()).get(noteKey(kind, entry.id)) ?? [];
---

<WikiNote
	title={entry.data.title || entry.id}
	description={entry.data.description}
	tags={entry.data.tags}
	updatedDate={entry.data.updatedDate}
	kind={kind}
	canonicalPath={canonicalPath}
	category={glossaryData?.category}
	aliases={glossaryData?.aliases}
	sources={glossaryData?.sources}
	supersededBy={glossaryData?.supersededBy}
	backlinks={backlinks}
>
	<Content />
</WikiNote>
