---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import WikiNote from '../../layouts/WikiNote.astro';

export async function getStaticPaths() {
	const notes = await getCollection('wiki');
	const paths = [];

	for (const note of notes) {
		// 1. Full path (e.g. concepts/multi-agent-orchestration)
		paths.push({
			params: { slug: note.id },
			props: note,
		});

		// 2. Filename-only alias (e.g. multi-agent-orchestration)
		const fileName = note.id.split('/').pop();
		if (fileName && fileName !== note.id) {
			paths.push({
				params: { slug: fileName },
				props: note,
			});
		}
	}

	return paths;
}
type Props = CollectionEntry<'wiki'>;

const note = Astro.props;
const { Content } = await render(note);
---

<WikiNote
	title={note.data.title || note.id}
	description={note.data.description}
	tags={note.data.tags}
	updatedDate={note.data.updatedDate}
>
	<Content />
</WikiNote>
