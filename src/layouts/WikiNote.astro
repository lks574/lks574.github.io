---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	tags?: string[];
	updatedDate?: Date;
	kind?: 'wiki' | 'glossary';
	canonicalPath?: string;
	category?: string;
	aliases?: string[];
	sources?: string[];
	supersededBy?: string;
}

const {
	title = 'Wiki Note',
	description = '',
	tags = [],
	updatedDate,
	kind = 'wiki',
	canonicalPath,
	category,
	aliases = [],
	sources = [],
	supersededBy,
} = Astro.props;

const categoryLabel: Record<string, string> = {
	ai: '🤖 AI & LLM',
	architecture: '🏗️ 아키텍처 & 코어',
	client: '📱 클라이언트 & 런타임',
	product: '🚀 프로덕트 & 데브옵스',
};

const isGlossary = kind === 'glossary';
const backHref = isGlossary ? '/wiki/glossary/' : '/wiki';
const backLabel = isGlossary ? '기술 용어집 (Glossary)' : '지식 위키 (Digital Garden)';
const badge = isGlossary ? `📖 ${categoryLabel[category ?? ''] ?? 'Glossary'}` : '🌿 Evergreen Note';
---

<html lang="ko">
	<head>
		<BaseHead title={`${title} | 지식 위키 - ${SITE_TITLE}`} description={description} canonicalPath={canonicalPath} />
	</head>

	<body>
		<Header />
		<main>
			<article class="wiki-wrapper">
				<div class="wiki-breadcrumb">
					<a href={backHref}>&larr; {backLabel}</a>
				</div>

				<header class="wiki-header">
					<div class="wiki-type-badge">{badge}</div>
					<h1 class="wiki-title">{title}</h1>
					{description && <p class="wiki-desc">{description}</p>}
					{
						supersededBy && (
							<p class="wiki-superseded">
								⚠️ 이 용어는 <a href={`/wiki/${supersededBy}/`}>{supersededBy}</a>로 대체되었습니다. 이력 보존을 위해 남겨둔 노트입니다.
							</p>
						)
					}
					{
						aliases.length > 0 && (
							<p class="wiki-aliases">
								별칭: {aliases.map((alias) => <span class="wiki-alias">{alias}</span>)}
							</p>
						)
					}

					<div class="wiki-meta">
						{
							updatedDate && (
								<span class="wiki-date">
									최종 업데이트: <FormattedDate date={updatedDate} />
								</span>
							)
						}
						{
							tags && tags.length > 0 && (
								<div class="wiki-tags">
									{tags.map((tag) => (
										<span class="wiki-tag">#{tag}</span>
									))}
								</div>
							)
						}
					</div>
				</header>

				<div class="prose wiki-content">
					<slot />
				</div>

				{
					sources.length > 0 && (
						<footer class="wiki-sources">
							<h2>📚 출처 & 승격 근거</h2>
							<ul>
								{sources.map((src) =>
									/^https?:\/\//.test(src) ? (
										<li>
											<a href={src} rel="noopener" target="_blank">
												{src}
											</a>
										</li>
									) : (
										<li>
											<a href={`/wiki/${src}/`}>{src}</a>
										</li>
									),
								)}
							</ul>
						</footer>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.wiki-superseded {
		margin: 0.75rem 0 0;
		padding: 0.6rem 0.9rem;
		border-radius: 8px;
		background: rgba(255, 170, 0, 0.08);
		border: 1px solid rgba(255, 170, 0, 0.4);
		font-size: 0.9rem;
	}

	.wiki-aliases {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.wiki-alias {
		display: inline-block;
		margin-left: 0.4rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		font-size: 0.8rem;
	}

	.wiki-sources {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border-color);
		font-size: 0.9rem;
	}

	.wiki-sources h2 {
		font-size: 1rem;
		margin: 0 0 0.5rem;
	}

	.wiki-wrapper {
		max-width: 760px;
		margin: 0 auto;
	}

	.wiki-breadcrumb {
		margin-bottom: 1.5rem;
	}

	.wiki-breadcrumb a {
		color: var(--text-muted);
		font-size: 0.9rem;
		font-weight: 500;
	}

	.wiki-breadcrumb a:hover {
		color: var(--accent);
	}

	.wiki-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border-color);
	}

	.wiki-type-badge {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		color: #15803d;
		background-color: #f0fdf4;
		border: 1px solid #bbf7d0;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		margin-bottom: 1rem;
	}

	@media (prefers-color-scheme: dark) {
		.wiki-type-badge {
			background-color: #052e16;
			color: #86efac;
			border-color: #16a34a;
		}
	}

	.wiki-title {
		font-size: 2.25rem;
		line-height: 1.3;
		margin: 0 0 0.75rem 0;
		letter-spacing: -0.02em;
	}

	.wiki-desc {
		font-size: 1.1rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0 0 1.25rem 0;
	}

	.wiki-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		font-size: 0.88rem;
		color: var(--text-muted);
	}

	.wiki-tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.wiki-tag {
		font-size: 0.8rem;
		background-color: var(--bg-secondary);
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		border: 1px solid var(--border-color);
	}

	.wiki-content {
		color: var(--text-primary);
		font-size: 1.05rem;
		line-height: 1.85;
	}

	.wiki-content :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}

	.wiki-content :global(h3) {
		margin-top: 1.75rem;
		margin-bottom: 0.75rem;
	}

	.wiki-content :global(p) {
		margin-bottom: 1.35rem;
	}

	.wiki-content :global(table) {
		margin: 1.75rem 0;
		border-collapse: collapse;
		width: 100%;
	}

	.wiki-content :global(th),
	.wiki-content :global(td) {
		padding: 0.75rem 1rem;
		border: 1px solid var(--border-color);
		text-align: left;
	}

	.wiki-content :global(th) {
		background-color: var(--bg-secondary);
		font-weight: 600;
	}
</style>
